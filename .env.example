CALENDLY_WEBHOOK_SIGNING_KEY=16982157ad57b60bfa0ed248a4eff1cc245390605783655fa08a3e5ae1b0fe6d

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=hhttps://dasboard-tau-murex.vercel.app/
