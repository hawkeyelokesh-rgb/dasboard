# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Calendly (admin account personal access token, scope availability:read + webhooks)
CALENDLY_TOKEN=your-calendly-personal-access-token
# Any long random string; used to verify webhooks and when registering them
CALENDLY_WEBHOOK_SIGNING_KEY=change-me-to-a-long-random-string

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
